{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Build (Release)",
      "type": "shell",
      "command": "cmake --build build --config Release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "CMake: Build (Debug)",
      "type": "shell",
      "command": "cmake --build build --config Debug",
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Simulation",
      "type": "shell",
      "command": ".\\run.cmd",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
